  * XRenderComposite, unlike the DIB-section conversion checked above. Sample
  * centers use the source/destination transform and RepeatNone outside the
  * source. XRender's 7-bit weights truncate before RGB565 quantization. */
+typedef struct { int64_t index;unsigned fraction;int active; } MovieAxis;
+static void movie_axis(MovieAxis* map,unsigned count,int32_t origin,int32_t extent,unsigned size) {
+    unsigned i;
+    for(i=0;i<count;i++) {
+        int64_t distance=(int64_t)i-origin;
+        map[i].active=distance>=0 && distance<extent;
+        if(map[i].active) {
+            int64_t fixed=((2*distance+1)*size*32768)/extent-32768;
+            map[i].index=fixed>=0 ? fixed/65536 : -((-fixed+65535)/65536);
+            map[i].fraction=(unsigned)(fixed-map[i].index*65536)>>9;
+        }
+    }
+}
