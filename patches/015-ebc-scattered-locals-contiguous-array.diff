     local_14 = (uint)*(byte *)(param_1 + 0x1d);
     _dth_shade = (int)(uint)*(byte *)(param_1 + 4) >> 4;
-    FUN_00411ebc(&local_40,draw_text_half);
+    FUN_00411ebc((int*)(int[12]){local_40,local_3c,local_38,local_34,local_30,local_2c,local_28,local_24,local_20,local_1c,local_18,local_14},draw_text_half);
   }
