CARVERT-BYTEOFF: car vertex buffers indexed with byte offsets (pointer-scaling)

The enemy-car damage-marker loops (FUN_00444178 region) write
`*(undefined2 *)(&car_vertices + iVar1)` with iVar1 = car*0x330 + 0x190.. -- a BYTE offset
(PROOF: the sibling writes in the SAME loop use raw byte addresses `iVar1 + 0x77d45a` /
`&DAT_0077d45c + iVar1` for the adjacent 2-byte fields). car_vertices@0x77d458 is int*-typed,
so the offset scales x4: for car >=4 the write lands ~0x4000 past the buffer -- exactly into
car_object@0x781418 (+0x3fc0), smashing the shape pointers Create_Object stored -> the
converged L8/L9/L10 crash (VVDraw_Object derefs param_1[1]=0x252). Draw_Car's
`&car_vertices + param_1 * 0x330` (vertex-buffer pointer into the shape header) scaled the
same way -> wrong vertices. Byte-address all &car_vertices/&DAT_0077d45c/high_/mid_ arithmetic.
Same Ghidra pointer-scaling class as COLOURMAT/BARRIER-BYTEOFF.

--- a/dd2.c
+++ b/dd2.c
@@ -18453,7 +18453,7 @@
   __lmptr = _lm;
   FUN_004203dc(psVar1,(int *)(&DAT_0078a744 + param_1 * 0x27c));
   bVar2 = _DAT_00754256 < 4000;
-  *(undefined1 **)(*(int *)((int)_level_data + 0x40) + 0x20) = &car_vertices + param_1 * 0x330;
+  *(undefined1 **)(*(int *)((int)_level_data + 0x40) + 0x20) = (int)&car_vertices + param_1 * 0x330;
   iVar3 = VVDraw_Object((undefined4 *)((int)&car_object + (uint)bVar2 * 0x1c + param_1 * 0x38));
   *(int *)(param_1 * 0x27c + 0x78a798) = iVar3;
   if ((iVar3 != 0) && (bVar2 == 1)) {
@@ -32389,16 +32389,16 @@
     do {
       iVar2 = iVar1 + 8;
       *(undefined2 *)(iVar1 + 0x77d45a) = 0x1b;
-      *(undefined2 *)(&DAT_0077d45c + iVar1) = 0xfe69;
-      *(undefined2 *)(&car_vertices + iVar1) = 0xff7e;
+      *(undefined2 *)((int)&DAT_0077d45c + iVar1) = 0xfe69;
+      *(undefined2 *)((int)&car_vertices + iVar1) = 0xff7e;
       iVar1 = iVar2;
     } while (iVar2 != param_1 * 0x330 + 0x1a0);
     iVar1 = param_1 * 0x330 + 0x160;
     do {
       iVar2 = iVar1 + 0x28;
       *(undefined2 *)(iVar1 + 0x77d45a) = 0x1b;
-      *(undefined2 *)(&DAT_0077d45c + iVar1) = 0xfe62;
-      *(undefined2 *)(&car_vertices + iVar1) = 0x98;
+      *(undefined2 *)((int)&DAT_0077d45c + iVar1) = 0xfe62;
+      *(undefined2 *)((int)&car_vertices + iVar1) = 0x98;
       iVar1 = iVar2;
     } while (iVar2 != param_1 * 0x330 + 0x1b0);
