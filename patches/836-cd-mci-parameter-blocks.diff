-    local_18 = 4;
-    mciSendCommandA(DAT_00462d78,0x814,0x100,(DWORD_PTR)local_20);
-    if ((local_1c != 0x20e) && (DAT_00462d74 != 0)) {
+    status[2] = 4;
+    mciSendCommandA(DAT_00462d78,0x814,0x100,(DWORD_PTR)status);
+    if ((status[1] != 0x20e) && (DAT_00462d74 != 0)) {
       MVar1 = mciSendCommandA(DAT_00462d78,0x806,0xc,0x74f170);
       if (MVar1 == 0) {
         DAT_00462d70 = 1;
