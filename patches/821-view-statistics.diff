+/* ===== View_Statistics @ 0044d300 ===== */
+/* Info-screen rec-0 ACTION: interactive stats-category viewer (Driver/Track/Championship).
+   Descriptor table @0x468050 stride 0x14 (+0 pos, +4 setup, +8 render). Reconstructed 1:1
+   from objdump; int(void) to match the nested `code`=int() dispatch (patch 818 family). */
+int View_Statistics(void)
+
+{
+  int cat;      /* ebx: category index */
+  int changed;  /* edi: category-changed flag */
+  int ret;      /* local_14 */
+  int esi14;
+  unsigned short pad;
+
+  /* entry: show category 0 */
+  *(unsigned short *)GIMG(0x467f38) = *(unsigned short *)GIMG(0x468050);
+  *(unsigned short *)GIMG(0x467f3a) = *(unsigned short *)GIMG(0x468052);
+  (*(code *)(uintptr_t)*(unsigned *)GIMG(0x468054))();          /* cat-0 setup */
+  FUN_00450fe0((int)GIMG(0x467f8c));
+  Setup_Screen_Text((int *)GIMG(0x467fe8));
+  Setup_Screen_Lines((int)GIMG(0x467f68));
+  cat = 0; changed = 0; ret = 0;
+  Rotate_Slab_On((short *)0);
+  for (;;) {                                                    /* loop top @0x44d35b */
+    Debug_Stub();
+    FUN_00420c4c();
+    FUN_00422da4();
+    pad = *(unsigned short *)GIMG(0x75444a);
+    if (pad & 0x80) {                                           /* LEFT: prev category */
+      FUN_00451c40();
+      Play_Click_FX();
+      changed = 1;
+      cat = *(unsigned char *)GIMG(0x468088 + cat * 4);
+      goto changed_check;
+    }
+    pad = *(unsigned short *)GIMG(0x75444a);
+    if (pad & 0x20) {                                           /* RIGHT: next category */
+      FUN_00451c40();
+      Play_Click_FX();
+      changed = 1;
+      cat = *(unsigned char *)GIMG(0x46808a + cat * 4);
+      goto changed_check;
+    }
+    pad = *(unsigned short *)GIMG(0x75444a);
+    if (pad & 0x4000) {                                         /* ACCEPT: drill in */
+      *(int *)GIMG(0x467f8e + cat * 0xb) = *(int *)GIMG(0x467fdc + cat * 4);
+      FUN_00450fe0((int)GIMG(0x467f8c));
+      Button_Pressed(7, (short *)0);
+      *(int *)GIMG(0x467f8e + cat * 0xb) = *(int *)GIMG(0x467fd0 + cat * 4);
+      esi14 = cat * 0x14;
+      FUN_00450fe0((int)GIMG(0x467f8c));
+      Button_Pressed(2, (short *)0);
+      FUN_00450e3c((short *)0);
+      (*(code *)(uintptr_t)*(unsigned *)GIMG(0x468058 + esi14))();   /* render */
+      (*(code *)(uintptr_t)*(unsigned *)GIMG(0x468054 + esi14))();   /* setup */
+      FUN_00450fe0((int)GIMG(0x467f8c));
+      Setup_Screen_Text((int *)GIMG(0x467fe8));
+      Setup_Screen_Lines((int)GIMG(0x467f68));
+      Rotate_Slab_On((short *)0);                               /* @0x44d469 push 0; jmp 0x44d356 */
+      continue;
+    }
+    pad = *(unsigned short *)GIMG(0x75444a);
+    if (pad & 0x1000) {                                         /* EXIT */
+      FUN_00450e3c((short *)0);
+      return ret;
+    }
+  changed_check:                                                /* @0x44d47c */
+    if (changed != 0) {
+      esi14 = cat * 0x14;
+      *(unsigned short *)GIMG(0x467f38) = *(unsigned short *)GIMG(0x468050 + esi14);
+      *(unsigned short *)GIMG(0x467f3a) = *(unsigned short *)GIMG(0x468052 + esi14);
+      FUN_00450fe0((int)GIMG(0x467f8c));
+      changed = 0;
+      (*(code *)(uintptr_t)*(unsigned *)GIMG(0x468054 + esi14))();   /* new-cat setup */
+    }
+    Draw_Slab();
+    Print_Draw();
+    Draw_Screen_Polys();
+    Draw_Screen_Lines();
+    Draw_All(1);                                                /* flip (asyncify suspend) */
+  }
+}
