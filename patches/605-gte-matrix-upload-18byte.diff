-  _DAT_0074c6fc = param_1[3];
-  _DAT_0074c700 = *(undefined2 *)(param_1 + 4);
+  { /* faithful 18-byte matrix copy (asm: movsd x4 + movsw to 0x74c6f0): __globmat is SHORT-typed,
+       so `__globmat = *param_1` stored only 2 of the 4 source bytes -> the odd matrix elements
+       (m01 @0x74c6f2, ...) KEPT THE PREVIOUS MATRIX (scene objects transformed with a mixed
