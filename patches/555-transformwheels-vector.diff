   short local_44 [16];
-  int local_24;
-  int local_20;
-  int local_1c;
+  /* contiguous 3-int wheel world-position vector: FUN_004203dc(local_44,&local_24) consumes
+     it as ONE block (scattered-locals class). Wheel positions feed Map_Height and the whole
+     landing dynamics -- this was the residual L2 cf138 native/wasm landing-impulse delta. */
+  int _wp[3];
+#define local_24 (_wp[0])
+#define local_20 (_wp[1])
+#define local_1c (_wp[2])
   int local_14;
   
   iVar1 = param_1 * 0x27c;
