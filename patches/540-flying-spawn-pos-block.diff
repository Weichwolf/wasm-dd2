+  /* contiguous 4-dword spawn position block @[ebp-0x20]: Setup_Flying_Objects reads it as
+     ONE vector (scattered-locals class; the detached part's trajectory diverged
+     native vs wasm from the spawn frame). */
+  int _pos[4];
+#define local_20 (_pos[0])
+#define uStack_1c (_pos[1])
+#define uStack_18 (_pos[2])
+#define uStack_14 (_pos[3])
   
   _permission = Request_Flying_Object(1);
   iVar1 = param_1 * 0x1b2;
@@ -33059,6 +33063,10 @@
   }
   return;
 }
+#undef local_20
+#undef uStack_1c
+#undef uStack_18
+#undef uStack_14
 
 
