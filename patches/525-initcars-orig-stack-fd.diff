     goto LAB_004435ec;
   }
+  { /* Reproduce the ORIGINAL's deterministic stack leftovers in the fd block. The per-level
+       setters only write the strip hint (+0x22) and lane (+0x2a); Search_For_Strip/FUN_00428678/
+       Track_Follow consume further fields, and the 11-dword copy publishes ALL of them into
+       car_fd. In the original these slots hold leftovers of the prior call chain -- captured
+       from the reference with tools/refinit.sh (gdb-frozen at FUN_004431e8 entry, L2):
+         [1]=0x0031fdc0 (caller stack addr), [2]=0x0041677c (return address into dd2h code),
+         [3]=0x0046cdcc (data pointer), [5..10]=0x10,0x1c,6,0xa0,0x1c,0x10.
+       These are binary-determined (same exe => same call chain => same values). fd[2] (the
+       pre-init z slot) is what makes the init Track_Follow settle on the reference's camera
+       start strip (0xfee0 chain; zeros settled 2 strips short at 0xff98 -- verified by A/B
+       against the reference's recorded_strips_). */
+    static const unsigned _orig_leftovers[11] = {
+      0x00000000,0x0031fdc0,0x0041677c,0x0046cdcc,0x00000000,
+      0x00000010,0x0000001c,0x00000006,0x000000a0,0x0000001c,0x00000010 };
+    int _k; for(_k=0;_k<0xb;_k++) local_74[_k]=(int)_orig_leftovers[_k];
