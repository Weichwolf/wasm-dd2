+
+/* Optional native return observations. This never supplies clock/RNG values
+ * or engine state. DD2_API_OBSERVE selects a new, exclusive output file.
+ * Format: DD2APIR1, little-endian record size 32, then eight DWORDs:
+ * kind, sequence, clock count, calculated RNG count, before, after, value,
+ * native caller PC. Frame/input observers can order boundaries by their
+ * observed clock+RNG counts, without a debugger stop at each API return. */
+#ifndef __EMSCRIPTEN__
+static FILE* dd2_api_file;
+static unsigned dd2_api_sequence;
+static int dd2_api_init;
+static void dd2_api_fail(const char* message){
+    fprintf(stderr,"[api-observer] %s\n",message);exit(1);
+}
+static void dd2_api_close(void){
+    if(dd2_api_file){
+        FILE* file=dd2_api_file;dd2_api_file=NULL;
+        if(fclose(file)!=0)dd2_api_fail("cannot close return log");
+    }
+}
+unsigned dd2_api_observer_flush(void){
+    int saved_errno=errno;
+    if(dd2_api_file && fflush(dd2_api_file)!=0)dd2_api_fail("cannot flush return log");
+    errno=saved_errno;return dd2_api_sequence;
+}
+static void dd2_api_observe(unsigned kind,unsigned before,unsigned after,unsigned value,unsigned caller){
+    unsigned words[8],i,j;unsigned char bytes[32];int saved_errno=errno;
+    if(!dd2_api_init){
+        const char* path=getenv("DD2_API_OBSERVE");dd2_api_init=1;
+        if(path){
+            static const unsigned char header[12]={'D','D','2','A','P','I','R','1',32,0,0,0};
+            const char* level=getenv("DD2_RANDOM_LEVEL");
+            if(!getenv("DD2_TICK_REPLAY") || !getenv("DD2_RANDOM_REFERENCE") ||
+                    !level || strcmp(level,"all") || getenv("DD2_REALTIME"))
+                dd2_api_fail("requires full clock/RNG reference inputs in headless clock mode");
+            dd2_api_file=fopen(path,"wbx");
+            if(!dd2_api_file)dd2_api_fail("cannot create exclusive return log");
+            if(fwrite(header,1,sizeof(header),dd2_api_file)!=sizeof(header))dd2_api_fail("cannot write return-log header");
+            atexit(dd2_api_close);
+        }
+    }
+    if(dd2_api_file){
+        if(dd2_api_sequence==0xffffffffu)dd2_api_fail("return-log sequence exhausted");
+        words[0]=kind;words[1]=++dd2_api_sequence;
+        words[2]=dd2_tick_calls;words[3]=g_rand_calls;
+        words[4]=before;words[5]=after;words[6]=value;words[7]=caller;
+        for(i=0;i<8;i++)for(j=0;j<4;j++)bytes[i*4+j]=(unsigned char)(words[i]>>(j*8));
+        if(fwrite(bytes,1,sizeof(bytes),dd2_api_file)!=sizeof(bytes))dd2_api_fail("cannot write return log");
+    }
+    errno=saved_errno;
+}
+#else
+unsigned dd2_api_observer_flush(void){return 0;}
+#endif
