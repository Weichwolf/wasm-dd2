Preserve the original software fallback for unsupported hardware buffers.

Original Wine traces show each bank source first requesting flags 0xe6,
receiving DSERR_UNSUPPORTED, and retrying with 0xe2. The software backend
previously accepted the unsupported hardware request and skipped this engine
branch. Return Wine's E_NOTIMPL before allocating or registering a buffer.

--- a/dd2h_stubs.c
+++ b/dd2h_stubs.c
@@ -453,7 +453,15 @@
 /* --- IDirectSound methods --- */
 static int ds_createbuffer(void* t,int* desc,DSBuf** pp,int outer){ (void)t;(void)outer;
     /* DSBUFFERDESC: +0 dwSize, +4 dwFlags, +8 dwBufferBytes, +0x10 lpwfxFormat */
-    DSBuf* b=dsb_new();
+    DSBuf* b;
+    /* Wine 10 rejects secondary DSBCAPS_LOCHARDWARE requests before allocation.
+       DSLoadSoundBuffer retries with 0xe2 after its initial 0xe6 request fails. */
+    if(desc && !(desc[1]&1) && (desc[1]&4)){
+        if(pp)*pp=NULL;
+        SLOG("DS CreateSoundBuffer hardware unsupported flags=%#x",desc[1]);
+        return (int)0x80004001u; /* DSERR_UNSUPPORTED == E_NOTIMPL */
+    }
+    b=dsb_new();
     b->size = desc? (unsigned)desc[2] : 0;
     b->flags = desc? (unsigned)desc[1] : 0;
     if(b->size){
