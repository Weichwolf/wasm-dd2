Retry recoverable movie PCM writes with Wine's best-effort ALSA semantics.

Wine 10 winealsa.drv alsa_write_best_effort returns immediately for EAGAIN,
but passes any other negative snd_pcm_writei result to snd_pcm_recover with
silent=0, then retries the unchanged buffer/count once on success. The native
movie transport previously treated every negative write except EAGAIN as
fatal. A single EINTR or recoverable EPIPE therefore disabled audio at startup
or failed an already playing movie, while the original's WaveOut transport
continued. Preserve source cursors until the retry actually accepts frames.
Recovery failure and a second failed write remain errors; no sample, source
extent, silence tail, clock, or completion boundary is fitted to a capture.

--- a/dd2_native_movie_alsa.h
+++ b/dd2_native_movie_alsa.h
@@ -70,6 +70,15 @@
         }
         n=movie_snd_pcm_writei(movie_alsa.device,data,count);
         if(n==-EAGAIN || n==0)return 0;
+        if(n<0){
+            /* Wine alsa_write_best_effort recovers a failed source write
+             * before retrying exactly the same samples and frame count. */
+            if(movie_snd_pcm_recover(movie_alsa.device,(int)n,0)<0)return -1;
+            n=movie_snd_pcm_writei(movie_alsa.device,data,count);
+            /* A retry can still find a full buffer; leave the source cursor
+             * untouched and let the next producer tick try again. */
+            if(n==-EAGAIN || n==0)return 0;
+        }
         if(n<0)return -1;
         if(left)movie_alsa.index+=n;
         movie_alsa.written+=n;available-=n;
