 #define surfai (*(int*)GIMG(0x0078a388))
 #define scene_colour_vectors (*(undefined1*)GIMG(0x00465922))
+#define sRam00465932 (*(short*)GIMG(0x00465932))
+#define sRam00465934 (*(short*)GIMG(0x00465934))
+#define sRam00465936 (*(short*)GIMG(0x00465936))
