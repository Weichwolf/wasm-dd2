@@ -59,11 +60,23 @@
         snd_pcm_uframes_t count=available;
         const int16_t* data=left?movie_alsa.source+movie_alsa.index*2:movie_alsa.silence;
         if(left && count>left)count=left;
+        if(!left){
+            snd_pcm_sframes_t pending=0;
+            int status=movie_snd_pcm_delay(movie_alsa.device,&pending);
+            if(status==-EPIPE)pending=0;
+            else if(status<0)return -1;
+            /* Wine keeps client data separate from its period-sized lead-in.
+             * Do not append silence while source frames are still pending. */
+            if(pending<0 || (uint64_t)pending>movie_alsa.written ||
+               movie_alsa.written-(uint64_t)pending<movie_alsa.frames)return 0;
+            if(count>movie_alsa.period)count=movie_alsa.period;
+        }
         n=movie_snd_pcm_writei(movie_alsa.device,data,count);
         if(n==-EAGAIN || n==0)return 0;
         if(n<0)return -1;
         if(left)movie_alsa.index+=n;
         movie_alsa.written+=n;available-=n;
+        if(!left)return 0; /* one driver silence period per producer tick */
     }
     return 0;
 }
