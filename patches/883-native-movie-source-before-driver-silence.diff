     X(snd_pcm_hw_params_set_buffer_size_near) X(snd_pcm_hw_params_get_buffer_size) \
+    X(snd_pcm_hw_params_get_period_size) \
     X(snd_pcm_hw_params) X(snd_pcm_sw_params_malloc) X(snd_pcm_sw_params_free) \
     X(snd_pcm_sw_params_current) X(snd_pcm_sw_params_set_start_threshold) \
     X(snd_pcm_sw_params_set_stop_threshold) X(snd_pcm_sw_params) \
@@ -29,7 +30,7 @@
