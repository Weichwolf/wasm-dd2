+/* Retain full integer horizontal sums until the vertical stage. Reuse
+ * source rows; no intermediate rounding or coefficient changes are allowed. */
+static void movie_filter_row(const uint8_t* rgb,unsigned width,unsigned height,
+                             int64_t y,const MovieAxis* horizontal,unsigned* row) {
+    unsigned x;
+    for(x=0;x<640;x++) {
+        unsigned k,wx=horizontal[x].active?horizontal[x].fraction:0;
+        int64_t sx=horizontal[x].active?horizontal[x].index:0;
+        for(k=0;k<3;k++) {
+            unsigned sum=0;
+            if(horizontal[x].active && y>=0 && y<height) {
+                if(sx>=0 && sx<width)sum=rgb[((size_t)y*width+(size_t)sx)*3+k]*(128-wx);
+                if(sx+1>=0 && sx+1<width)sum+=rgb[((size_t)y*width+(size_t)(sx+1))*3+k]*wx;
+            }
+            row[x*3+k]=sum;
+        }
+    }
+}
