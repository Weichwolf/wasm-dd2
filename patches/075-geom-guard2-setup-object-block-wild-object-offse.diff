     do {
       iVar2 = *piVar3;
-      Set_Object(local_20,(int)param_1 + iVar2);
-      if ((*(byte *)((int)param_1 + iVar2 + 4) & 0x80) == 0) {
+      { unsigned _op = (unsigned)((int)param_1 + iVar2);
+        Set_Object(local_20, (_op >= 0x400000u && _op < 0x900000u) ? (int)param_1 + iVar2 : (int)param_1); }
+      if (((unsigned)((int)param_1+iVar2) < 0x400000u || (unsigned)((int)param_1+iVar2) >= 0x900000u) || (*(byte *)((int)param_1 + iVar2 + 4) & 0x80) == 0) {
         *piVar5 = (piVar3[1] & 0xffff8000U) + 0x4000;
         piVar5[1] = (piVar3[2] & 0xffff8000U) + 0x4000;
