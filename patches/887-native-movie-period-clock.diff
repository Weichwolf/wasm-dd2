Correct native movie producer waits against an advancing period clock.

Wine 10 ALSA advances its next-period counter independently of processing,
then corrects the next relative wait by the measured wake error, clamped to
half a period. Native SDL_Delay(10) added each fill's cost to every period.

Use a monotonic nanosecond period clock with Wine's bounded correction.
Keep the initial main-thread source fill and ready-before-play ordering;
only producer cadence changes. Retry interrupted waits without shortening
their requested interval. Do not shift source bytes, timestamps or EOS.
This is the Wine scheduling rule, not a whole-output or shared-clock proof.

--- a/dd2_native_movie_alsa.h
+++ b/dd2_native_movie_alsa.h
@@ -5,6 +5,7 @@
 #include <alsa/asoundlib.h>
 #include <dlfcn.h>
 #include <errno.h>
+#include <time.h>
 #define MOVIE_ALSA_SYMBOLS(X) \
     X(snd_pcm_open) X(snd_pcm_close) X(snd_pcm_drop) X(snd_pcm_reset) X(snd_pcm_prepare) \
     X(snd_pcm_hw_params_malloc) X(snd_pcm_hw_params_free) X(snd_pcm_hw_params_any) \
@@ -92,13 +93,26 @@
     }
     return 0;
 }
+static int64_t movie_alsa_clock_ns(void){
+    struct timespec now;clock_gettime(CLOCK_MONOTONIC,&now);
+    return (int64_t)now.tv_sec*1000000000+now.tv_nsec;
+}
 static int movie_alsa_worker(void* ignored){
+    const int64_t period=10000000;
+    int64_t delay=period,next=movie_alsa_clock_ns()+period,adjust;
     (void)ignored;
     while(!SDL_AtomicGet(&movie_alsa.stop)){
-        SDL_Delay(10);
+        struct timespec wait={0,(long)delay},remaining;
+        while(nanosleep(&wait,&remaining)<0 && errno==EINTR)wait=remaining;
         if(SDL_AtomicGet(&movie_alsa.stop))break;
         SDL_LockMutex(movie_alsa.mutex);
         if(SDL_AtomicGet(&movie_alsa.stop)){SDL_UnlockMutex(movie_alsa.mutex);break;}
+        /* Wine measures wake error before processing this period, advances
+         * the target independently, and bounds each correction to half P. */
+        adjust=next-movie_alsa_clock_ns();
+        if(adjust>period/2)adjust=period/2;
+        else if(adjust<-period/2)adjust=-period/2;
+        delay=period+adjust;next+=period;
         if(movie_alsa_fill() && !movie_alsa.source_done)movie_alsa.error=1;
         SDL_UnlockMutex(movie_alsa.mutex);
         if(movie_alsa.error)break;
