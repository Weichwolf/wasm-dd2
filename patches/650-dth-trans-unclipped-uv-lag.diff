draw_text_half_trans @0x4109e8: the UNCLIPPED (dth_clip==0) span loop of the
semi-transparent blitter samples u/v with a ONE-PIXEL LAG -- an original-engine
quirk that patch 630's reconstruction missed.

asm (unclipped loop, 0x410cba-0x410cd5):
  410cba: 8a 10     mov (%eax),%dl     ; texel[tpage|ah|al]
  410cbc: 8a 02     mov (%edx),%al     ; clut[texel]
  410cbe: 8a 27     mov (%edi),%ah     ; dst
  410cc0: 66 8b f0  mov %ax,%si
  410cc3: 8a 16     mov (%esi),%dl     ; blend[(dst<<8)|clutpix]
  410cc5: 8a c7     mov %bh,%al        ; <-- next u byte taken BEFORE ...
  410cc7: 03 1d 18 00 48 00 add 0x480018,%ebx  ; ... the u step
  410ccd: 47        inc %edi
  410cce: 8a e5     mov %ch,%ah        ; <-- next v byte taken BEFORE ...
  410cd0: 03 cd     add %ebp,%ecx      ; ... the v step
  410cd2: 88 57 ff  mov %dl,-0x1(%edi)
  410cd5: 7f e3     jg  0x410cba

The CLIPPED loop of the same function (0x410bd7-0x410bf2) and both loops of
opaque draw_text_half (0x4101e6/0x4102be) refresh al/ah AFTER the adds -- no
lag there.  Effect: an unclipped trans span samples (u0,v0),(u0,v0),(u1,v1),
...,(u_{n-2},v_{n-2}) -- first texel doubled, rest shifted one pixel.  Visible
wherever the texture has per-texel detail: the start-light LED dither circles
(fb box x=260..383 y=108..166 vs the cf3 reference) checkerboarded because our
reconstruction sampled without the lag.  Fix: model the al/ah registers
explicitly and refresh them before the u/v steps, register-for-register.

--- a/dd2.c
+++ b/dd2.c
@@ -1362,18 +1362,30 @@
           iVar8 = DAT_00480018;
           iVar6 = (dth_x2 >> 8) - (dth_x1 >> 8);
           if (0 < iVar6) {
+            /* UNCLIPPED trans loop (asm 0x410cba-0x410cd5): unlike the clipped loop
+               @0x410bd7 (and unlike draw_text_half), the texel-address bytes are
+               refreshed BEFORE the u/v steps -- `mov bh,al` @0x410cc5 precedes
+               `add [0x480018],ebx` @0x410cc7 and `mov ch,ah` @0x410cce precedes
+               `add ebp,ecx` @0x410cd0.  The sampled u/v therefore LAG one pixel:
+               the span samples (u0,v0),(u0,v0),(u1,v1),...  This original quirk is
+               visible wherever the texture has per-texel detail (start-light LED
+               dither circles); sampling without the lag produced the checkerboard
+               fb diff vs the reference. */
             unsigned _ecx = ((unsigned)dth_v1 & 0xffffu) | ((unsigned)(iVar6 - 1) << 16);
             unsigned _uu = (unsigned)dth_u1;
+            unsigned _al = (_uu >> 8) & 0xffu, _ah = _ecx & 0xff00u;
             unsigned char *_dst = (unsigned char *)(&_screenbuffer + dth_y1 * 0x280 + (dth_x1 >> 8));
             for (;;) {
               unsigned char _tx = *(unsigned char *)(uintptr_t)
-                  (((unsigned)(uintptr_t)DAT_0046000c & 0xffff0000u) | (_ecx & 0xff00u) | ((_uu >> 8) & 0xffu));
+                  (((unsigned)(uintptr_t)DAT_0046000c & 0xffff0000u) | _ah | _al);
               unsigned char _sc = *(unsigned char *)(uintptr_t)
                   (((unsigned)(uintptr_t)DAT_00460004 & 0xffffff00u) | _tx);
               *_dst = *(unsigned char *)(uintptr_t)
                   (((unsigned)(uintptr_t)DAT_00460010 & 0xffff0000u) | ((unsigned)*_dst << 8) | _sc);
               _dst++;
+              _al = (_uu >> 8) & 0xffu;   /* asm 0x410cc5: al refreshed BEFORE u step */
               _uu += (unsigned)iVar8;
+              _ah = _ecx & 0xff00u;       /* asm 0x410cce: ah refreshed BEFORE v step */
               _ecx += (unsigned)iVar2;
               if ((int)_ecx <= 0) break;
             }
