+/* Exact Wine FIR operations, accelerated by the same native i386 x87.
+ * The reconstructed engine uses 53-bit precision; only this mixer uses 64.
+ * Non-i386 and WASM retain the independently checked integer implementation.
+ * DD2_MIX_FORCE_SOFTWARE is for arithmetic/PCM regression comparisons. */
+#ifndef DD2_SOUND_MIXWIDE_H
+#define DD2_SOUND_MIXWIDE_H
+#include "dd2_sound_wide.h"
+#if defined(__i386__) && !defined(__EMSCRIPTEN__) && !defined(DD2_MIX_FORCE_SOFTWARE)
+typedef long double DD2MixWide;
+#define DD2_MIX_ZERO 0.0L
+static unsigned short dd2_mix_begin(void){
+    unsigned short previous,wide;
+    __asm__ __volatile__("fnstcw %0":"=m"(previous)::"memory");
+    wide=(previous&~0x0f00u)|0x0300u;
+    __asm__ __volatile__("fldcw %0"::"m"(wide):"memory");
+    return previous;
+}
+static void dd2_mix_end(unsigned short previous){
+    __asm__ __volatile__("fldcw %0"::"m"(previous):"memory");
+}
+static DD2MixWide dd2_mix_float(float mix_value){
+    return mix_value ? (long double)mix_value : 0.0L;
+}
+static DD2MixWide dd2_mix_ratio(uint64_t numerator,uint32_t denominator){
+    volatile long double mix_value=(long double)numerator/denominator;
+    return mix_value;
+}
+static DD2MixWide dd2_mix_mul(DD2MixWide a,DD2MixWide b){
+    volatile long double mix_value=a*b;
+    return mix_value ? mix_value : 0.0L;
+}
+static DD2MixWide dd2_mix_add(DD2MixWide a,DD2MixWide b){
+    volatile long double mix_value=a+b;
+    return mix_value;
+}
+static DD2MixWide dd2_mix_negate(DD2MixWide mix_value){return -mix_value;}
+static float dd2_mix_to_float(DD2MixWide mix_value){
+    volatile float result=mix_value ? (float)mix_value : 0.0f;
+    return result;
+}
+#else
+typedef DD2Wide DD2MixWide;
+#define DD2_MIX_ZERO {0,0,0}
+static unsigned short dd2_mix_begin(void){return 0;}
+static void dd2_mix_end(unsigned short previous){(void)previous;}
+static DD2MixWide dd2_mix_float(float mix_value){return dd2_wide_float(mix_value);}
+static DD2MixWide dd2_mix_ratio(uint64_t numerator,uint32_t denominator){
+    return dd2_wide_ratio(numerator,denominator);
+}
+static DD2MixWide dd2_mix_mul(DD2MixWide a,DD2MixWide b){return dd2_wide_mul(a,b);}
+static DD2MixWide dd2_mix_add(DD2MixWide a,DD2MixWide b){return dd2_wide_add(a,b);}
+static DD2MixWide dd2_mix_negate(DD2MixWide mix_value){mix_value.negative^=1;return mix_value;}
+static float dd2_mix_to_float(DD2MixWide mix_value){return dd2_wide_to_float(mix_value);}
+#endif
+#endif
