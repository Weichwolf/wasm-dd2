+        ds_service_callback_finish();
+        ds_service_callback_active=0;
+        ds_service_callback_switch(0);
+    }
+}
+static void ds_service_callback_start(unsigned id){
+    if(!ds_service_fiber_init){
+        ds_service_timer_stack=malloc(DD2_SERVICE_STACK);
+        if(!ds_service_timer_stack)ds_service_error("cannot allocate callback stack");
+#ifdef __EMSCRIPTEN__
+        ds_service_main_async=malloc(DD2_SERVICE_STACK);
+        ds_service_timer_async=malloc(DD2_SERVICE_STACK);
+        if(!ds_service_main_async || !ds_service_timer_async)ds_service_error("cannot allocate callback continuations");
+        emscripten_fiber_init_from_current_context(&ds_service_main_fiber,
+            ds_service_main_async,DD2_SERVICE_STACK);
+        emscripten_fiber_init(&ds_service_timer_fiber,ds_service_callback_entry,0,
+            ds_service_timer_stack,DD2_SERVICE_STACK,ds_service_timer_async,DD2_SERVICE_STACK);
+#else
+        if(getcontext(&ds_service_timer_fiber))ds_service_error("cannot create callback context");
+        ds_service_timer_fiber.uc_stack.ss_sp=ds_service_timer_stack;
+        ds_service_timer_fiber.uc_stack.ss_size=DD2_SERVICE_STACK;
+        ds_service_timer_fiber.uc_link=0;
+        makecontext(&ds_service_timer_fiber,ds_service_callback_entry,0);
+#endif
+        ds_service_fiber_init=1;
+    }
+    ds_service_callback_active=id;
+    ds_service_callback_switch(1);
+}
