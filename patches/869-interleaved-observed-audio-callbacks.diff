+static void ds_service_callback_switch(unsigned to_timer){
+    ds_service_context=to_timer?ds_service_callback_active:0;
+#ifdef __EMSCRIPTEN__
+    emscripten_fiber_swap(to_timer?&ds_service_main_fiber:&ds_service_timer_fiber,
+                         to_timer?&ds_service_timer_fiber:&ds_service_main_fiber);
+#else
+#ifdef __SANITIZE_ADDRESS__
+    __sanitizer_start_switch_fiber(to_timer?&ds_service_main_fake:&ds_service_timer_fake,
+        to_timer?ds_service_timer_stack:ds_service_main_stack,
+        to_timer?DD2_SERVICE_STACK:ds_service_main_stack_size);
+#endif
+    if(swapcontext(to_timer?&ds_service_main_fiber:&ds_service_timer_fiber,
+                   to_timer?&ds_service_timer_fiber:&ds_service_main_fiber))
+        ds_service_error("callback context switch failed");
+#ifdef __SANITIZE_ADDRESS__
+    __sanitizer_finish_switch_fiber(to_timer?ds_service_main_fake:ds_service_timer_fake,0,0);
+#endif
+#endif
+}
+#ifdef __EMSCRIPTEN__
+static void ds_service_callback_entry(void* unused){
+    (void)unused;
+#else
+static void ds_service_callback_entry(void){
