+/* Called on the callback stack before an API assertion. Suspend that
+ * exact continuation while the independently running main caller supplies
+ * its own intervening operations. Do not consume those operations here. */
+static void ds_service_caller_ready(void){
+    ds_service_advance();
+#ifdef DD2_SERVICE_FIBERS
+    while(ds_service_context && ds_service_index<ds_service_count &&
+          ds_services[ds_service_index].context!=ds_service_context &&
+          (ds_services[ds_service_index].kind<=12 || ds_services[ds_service_index].kind==32)){
+        ds_service_callback_switch(0);
+        ds_service_advance();
+    }
+#endif
+}
+static void ds_service_callback_finish(void){
+    DD2AudioService* end;
+    ds_service_caller_ready();
+    if(ds_service_index==ds_service_count)ds_service_error("unreturned callback");
+    end=&ds_services[ds_service_index];
+    if(end->kind!=31 || end->sid!=ds_service_context || end->context!=ds_service_context)
+        ds_service_error("callback left unmatched API calls");
+    ds_service_index++;ds_service_callbacks++;
 }
