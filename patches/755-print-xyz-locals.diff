FIX PRINT-XYZ-LOCALS: Front_End menus drew BLACK — Print's parsed x/y were phantom stack slots

Scattered-locals artifact (class of 070/655/705/710/745), the front-end blocker:
Print @0x421404 parses %-commands from the text string; the coordinate parser
FUN_00422258(&block, str, pos) fills a contiguous 3-int x/y/z block at
ebp-0x88..-0x7c (asm lea/mov -0x88/-0x84(%ebp)). Ghidra emitted the call as
FUN_00422258(&stack0xffffff78,...) and the x/y read-backs as undeclared
"in_stack_ffffff78/7c" phantoms (only z survived as local_80): in compiled C
the parser wrote one place and the record stores read another -> every FE text
record had y=0 -> all menu glyph quads collapsed to zero height at
y=screen_height/2 (measured: ALL OT quads with every vertex y=240) -> the
entire front end (menus/track select) rendered black while the menu state
machine ran fine underneath.

--- a/dd2.c
+++ b/dd2.c
@@ -12832,9 +12832,19 @@
   int iVar11;
   int iVar12;
   char *pcVar13;
-  int in_stack_ffffff78;
-  undefined4 in_stack_ffffff7c;
-  undefined4 local_80;
+  /* ONE contiguous 3-int x/y/z block at ebp-0x88..-0x7c: the %-command parser FUN_00422258
+     is called as FUN_00422258(&block, str, pos) (asm: lea -0x88(%ebp)-family address-takes at
+     0x4214f4/0x42168b/0x42185f) and writes all three values through the pointer; the record
+     stores read them back (asm 0x421539/0x4216cf/0x4218a3: mov -0x84(%ebp),...). Ghidra lost
+     the first two slots as phantom "in_stack_ffffff78/7c" (undeclared reads = C garbage) and
+     kept only z as local_80 -> every FE text record got y=0 -> all menu glyph quads
+     degenerated to height 0 at y=screen_height/2 -> the whole front end drew BLACK.
+     Same scattered-locals class as patches 070/655/705/710/745. */
+  int _prxyz[3];
+#define in_stack_ffffff78 (_prxyz[0])
+#define in_stack_ffffff7c (_prxyz[1])
+#define local_80 (_prxyz[2])
+#define stack0xffffff78 (_prxyz[0])
   char local_7c [12];
   undefined1 local_70;
   undefined1 local_6f;
@@ -13196,6 +13206,10 @@
     }
   } while( true );
 }
+#undef in_stack_ffffff78
+#undef in_stack_ffffff7c
+#undef local_80
+#undef stack0xffffff78
 
 
