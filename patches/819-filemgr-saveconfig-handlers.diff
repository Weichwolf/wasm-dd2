FIX FE FILE-MANAGER + SAVE-CONFIG (819): reconstruct unexported wrapper handlers

File Manager (main screen 3 action 0x44aae0) and the Config "Save Configuration" sub-action
(0x44ed44 -> 0x44ab50) were unexported raw VAs -> wasm call_indirect trap ("table index out of
bounds") + unrecoverable FE hang on entering them. All three are thin wrappers over the
existing LoadSave / FUN_0044ae0c; reconstructed 1:1 from asm and registered so dd2_relocate
rewrites the table slots.

--- a/dd2.c
+++ b/dd2.c
@@ -531,6 +531,9 @@
 void Duplicate_Results(void);
 void Load_Card_File(void);
 void __cdecl FUN_0044ae0c(undefined2 *param_1,undefined2 param_2);
+undefined4 FUN_0044aae0(void);
+void FUN_0044ab50(void);
+undefined4 FUN_0044ed44(void);
 void __cdecl FUN_0044b038(int *param_1);
 void Init_Front_End(void);
 undefined4 View_Frontend_Replay(void);
@@ -39520,6 +39523,41 @@
 }
 
 
+/* ===== FUN_0044aae0 @ 0044aae0 (File Manager, main-menu screen 3 action) ===== */
+/* Unexported wrapper: opens the save/load file browser via LoadSave(mode 0). Ghidra never
+   exported it, so the main-table action dispatch @0x4697d0 jumped to a raw code VA -> wasm
+   call_indirect trap. asm 0x44aae0: push &DAT_0093a490; push 0; call LoadSave; ret. int(void)
+   (dispatched as `code`=int(); returns LoadSave's result, discarded by the caller). */
+undefined4 FUN_0044aae0(void)
+
+{
+  return LoadSave(0,(undefined4 *)&DAT_0093a490);
+}
+
+
+/* ===== FUN_0044ab50 @ 0044ab50 (save-config helper) ===== */
+/* asm 0x44ab50: FUN_0044ae0c(&DAT_0093a490,0x1010); LoadSave(3,&DAT_0093a490). Called directly
+   by the Save Configuration action (no table dispatch). */
+void FUN_0044ab50(void)
+
+{
+  FUN_0044ae0c((undefined2 *)&DAT_0093a490,0x1010);
+  LoadSave(3,(undefined4 *)&DAT_0093a490);
+  return;
+}
+
+
+/* ===== FUN_0044ed44 @ 0044ed44 (Configuration dialog rec-2 "Save Configuration" action) ===== */
+/* asm 0x44ed44: call 0x44ab50; xor eax,eax; ret. Unexported -> Config sub-table @0x469190 rec-2
+   dispatched a raw VA -> trap. int(void), returns 0. */
+undefined4 FUN_0044ed44(void)
+
+{
+  FUN_0044ab50();
+  return 0;
+}
