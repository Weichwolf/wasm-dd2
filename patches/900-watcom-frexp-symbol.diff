Preserve the original Watcom frexp bits without overriding the host libc.

The generated int frexp(void) stub shadows Emscripten libc's double(double,
int*) function. vfprintf links a signature-mismatch trap and floating-point
formatting can abort. The original 0x45c0f0-0x45c16a routine instead takes
its IEEE-754 argument on the stack and returns the result bits in EDX:EAX.
Reconstruct those integer instructions under a private symbol with uint64_t
arguments/return, preserving the i386 bit ABI and the raw-VA dispatch entry.
Signed zeros, subnormals, infinities and NaNs follow the original instructions;
they must not be substituted with the different standard libc edge behavior.
The ordinary frexp symbol is now supplied by libc for its own C callers.

--- a/dd2.c
+++ b/dd2.c
@@ -910,7 +910,7 @@
 int FUN_0045b9d4();
 int FUN_0045bf9a();
 int FUN_0045c058();
-int frexp();
+uint64_t dd2_watcom_frexp(uint64_t bits, int *exponent);
 int __math1err();
 int _set_matherr();
 int __rterrmsg();
@@ -47986,8 +47986,21 @@
 int FUN_0045bf9a(){ return 0; }
 /* ===== FUN_0045c058 @ 0045c058 ===== */
 int FUN_0045c058(){ return 0; }
-/* ===== frexp @ 0045c0f0 ===== */
-int frexp(){ return 0; }
+/* ===== dd2_watcom_frexp @ 0045c0f0 ===== */
+/* Original 0x45c0f0-0x45c16a takes double bits on the stack and returns
+   double bits in EDX:EAX. A uint64_t preserves that Watcom register return
+   on i386 and gives the translated dispatch target an explicit WASM type.
+   Keep this separate from libc frexp: the original does not normalize
+   subnormals or preserve infinity/NaN like the host math implementation. */
+uint64_t dd2_watcom_frexp(uint64_t bits, int *exponent)
+{
+    if ((bits & UINT64_C(0x7fffffffffffffff)) == 0) {
+        *exponent = 0;
+        return bits;
+    }
+    *exponent = (int)((bits >> 52) & 0x7ff) - 0x3fe;
+    return (bits & UINT64_C(0x800fffffffffffff)) | UINT64_C(0x3fe0000000000000);
+}
 /* ===== __math1err @ 0045c16b ===== */
 int __math1err(){ return 0; }
 /* ===== _set_matherr @ 0045c2f1 ===== */
--- a/dd2_dispatch.c
+++ b/dd2_dispatch.c
@@ -863,7 +863,7 @@
 extern int FUN_0045b9d4();
 extern int FUN_0045bf9a();
 extern int FUN_0045c058();
-extern int frexp();
+extern uint64_t dd2_watcom_frexp(uint64_t, int*);
 extern int __math1err();
 extern int _set_matherr();
 extern int __rterrmsg();
@@ -1781,7 +1781,7 @@
 {0x0045b9d4,(void*)&FUN_0045b9d4},
 {0x0045bf9a,(void*)&FUN_0045bf9a},
 {0x0045c058,(void*)&FUN_0045c058},
-{0x0045c0f0,(void*)&frexp},
