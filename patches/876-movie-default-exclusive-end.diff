Match the original's observed Wine 10 MCI default exclusive play end.

Actual dd2h.exe's default INTRO.AVI play draws frames 0..1710, while the
container has 1712 source frames. Wine 10 MCIAVI_mciPlay sets its default
dwToVideoFrame to dwPlayableVideoFrames - 1; MCIAVI_player draws strictly
below that bound. An independent real-MCI near-end fixture observes the
same exclusive end for INTRO.AVI and OUTRO.AVI. The original Play_Movie
supplies no MCI_TO and uses this default.

Keep all AVI source frames available for decoding/seeking. Restrict default
MCI playback only. Completion still waits for available audio to drain.
Full movie audio/device-clock and physical timing parity remain separate.

https://github.com/wine-mirror/wine/blob/wine-10.0/dlls/mciavi32/mciavi.c

--- a/dd2_movie.c
+++ b/dd2_movie.c
@@ -54,9 +54,12 @@
 void dd2_movie_pump(void) {
     const DD2AVIInfo* info;
-    unsigned elapsed;
+    unsigned elapsed,end_frame;
     if(!playing)return;
     info=dd2_avi_info(movie);elapsed=dd2_movie_now_ms()-start_ms;
-    while(next_frame<info->frames && (uint64_t)next_frame*info->video_scale*1000<= (uint64_t)elapsed*info->video_rate) {
+    /* Actual Wine 10 MCI default: last source frame is an exclusive bound.
+     * The AVI decoder retains that frame for its separate source contract. */
+    end_frame=info->frames-1;
+    while(next_frame<end_frame && (uint64_t)next_frame*info->video_scale*1000<= (uint64_t)elapsed*info->video_rate) {
         const uint8_t* rgb=dd2_avi_frame(movie,next_frame);
         if(!rgb || dd2_movie_render_window(rgb,info->width,info->height,destination,image)) {
             dd2_movie_audio_stop();finish(8);return; /* MCI_NOTIFY_FAILURE */
@@ -66,5 +69,5 @@
         dd2_movie_present(image);next_frame++;
     }
-    if(next_frame==info->frames && (uint64_t)elapsed*info->video_rate>=(uint64_t)info->frames*info->video_scale*1000
+    if(next_frame==end_frame && (uint64_t)elapsed*info->video_rate>=(uint64_t)end_frame*info->video_scale*1000
             && (!audio_available || dd2_movie_audio_done()))finish(1); /* MCI_NOTIFY_SUCCESSFUL */
 }
