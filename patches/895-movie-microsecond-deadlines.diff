+double dd2_movie_now_us(void) {
+#ifdef DD2_BROWSER
+    return movie_clock_us();
+#else
+    struct timespec ts;
+    uint64_t ticks,scaled;
+#ifdef CLOCK_MONOTONIC_RAW
+    if(clock_gettime(CLOCK_MONOTONIC_RAW,&ts))
+#endif
+        clock_gettime(CLOCK_MONOTONIC,&ts);
+    /* Wine QPC uses 100-ns ticks. MCIAVI currenttime_us performs signed
+     * 64-bit multiply/divide before converting to double. Unsigned multiply
+     * makes its x86 wrap defined here, including the signed quotient. */
+    ticks=(uint64_t)ts.tv_sec*10000000u+ts.tv_nsec/100u;
+    scaled=ticks*1000000u;
+    return (double)((int64_t)scaled/10000000);
 #endif
 }
