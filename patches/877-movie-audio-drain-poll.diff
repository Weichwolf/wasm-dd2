-            && (!audio_available || dd2_movie_audio_done()))finish(1); /* MCI_NOTIFY_SUCCESSFUL */
+    /* MCIAVI_player leaves its video loop immediately after the final draw.
+     * It checks completed wave headers, then sleeps 100 ms before each retry.
+     * A queued/played PCM extent remains the platform's separate contract. */
+    if(next_frame==end_frame) {
