EAXARG-456d27 refinement: the SECOND fill of each Init_*_Objects pair targets the LOCAL array

Patch 055 recovered FUN_00456d27's EAX dest as 0x7892a0 for every (0xe,-1) caller -- correct
for Init_Scene @0x430399 and Init_Bowl_Objects @0x430da6, but Init_Scene_Objects/
Init_Track_Objects @0x430ddc/0x430de8 call it TWICE in a row: the first with
mov eax,0x7892a0 (asm 0x430e01), the second with lea eax,[ebp-0x48] (asm 0x430e18) = the
local 14-entry active-block ARRAY (local_4c/aiStack_4c). With both wired to 0x7892a0 the
local array kept stack garbage -> FUN_00430d0e's flush loop treated a garbage entry as a
block number -> Decrunch_Object_Block wild read (post-365 L1-7 crash).

--- a/dd2.c
+++ b/dd2.c
@@ -21179,7 +21179,7 @@
   }
   iVar3 = *(int *)(_camera_fd_pt + 0x14);
   (_g_eax=0x7892a0, FUN_00456d27(0xe,0xffffffff));
-  (_g_eax=0x7892a0, FUN_00456d27(0xe,0xffffffff));
+  (_g_eax=(unsigned)(uintptr_t)local_4c, FUN_00456d27(0xe,0xffffffff));  /* asm 0x430e18: lea eax,[ebp-0x48] = the local 14-entry block array, NOT 0x7892a0 */
   iVar2 = 0;
   do {
     iVar6 = _strip_data;
