-    FUN_0041243c(&iStack_40,draw_half);
+    { int _q[6];  /* contiguous vertex array: asm keeps [x1,y1,x2,y2,x3,y3] at [ebp-0x40..-0x2c]
+                     and the edge sorter indexes it as ONE array; gcc scatters the separate
