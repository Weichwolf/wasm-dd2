FUN_00456cf0 byte-memset wrapper: wire the EAX chain through the dword-fill callee

FUN_00456cf0 @0x456cf0 is the Watcom byte-memset (dest in EAX): it aligns dest byte-wise
(rotating the pattern), calls the dword-fill FUN_00456d27 for count>>2, then writes the
0-3 tail bytes at the ADVANCED dest (EAX after the callee) with the rotated pattern (EDX).
Ghidra dropped the whole register chain: the inner call didn't update _g_eax (callee filled
the CALLER's last dest again -> wild/NULL fill = post-370 L1-7 crash), and the tail-byte
pointer/pattern came from an undefined6 extraout. Wire _g_eax = the aligned in_EAX before
the call and synthesize the outputs (dest+((n>>2)<<2), pattern bytes from param_2 -- the
callee does not rotate).
Also recover the one direct caller FUN_004478e0 @0x4478f1: mov eax,0x9376b0 (0x1c00-byte
clear of the replay/strip buffer).

--- a/dd2.c
+++ b/dd2.c
@@ -34040,7 +34040,7 @@
 
 {
   if (DAT_00467074 == 0) {
-    FUN_00456cf0(0x1c00,0);
+    (_g_eax=0x9376b0, FUN_00456cf0(0x1c00,0));  /* asm 0x4478f1: mov eax,0x9376b0 (0x1c00-byte clear) */
   }
   _Replay_Script_Ptr = &Replay_Script;
   if (DAT_00467074 != 0) {
@@ -43888,7 +43888,6 @@
   undefined1 *puVar1;
   uint uVar2;
   undefined1 uVar3;
-  undefined6 uVar4;
   
   if (param_1 != 0) {
     do {
@@ -43898,13 +43897,13 @@
       param_2 = param_2 >> 8 | param_2 << 0x18;
       param_1 = param_1 - 1;
     } while (param_1 != 0);
-    uVar4 = FUN_00456d27(param_1 >> 2,param_2);
-    puVar1 = (undefined1 *)uVar4;
+    (_g_eax=(unsigned)(uintptr_t)in_EAX, FUN_00456d27(param_1 >> 2,param_2));
+    puVar1 = in_EAX + ((param_1 >> 2) << 2);  /* EAX after the dword fill = advanced dest */
     uVar2 = param_1 & 3;
     if (uVar2 != 0) {
-      uVar3 = (undefined1)((uint6)uVar4 >> 0x20);
+      uVar3 = (undefined1)param_2;            /* DL after the call = low byte of the rotated pattern */
       *puVar1 = uVar3;
-      if ((uVar2 != 1) && (puVar1[1] = (char)((uint6)uVar4 >> 0x28), uVar2 != 2)) {
+      if ((uVar2 != 1) && (puVar1[1] = (char)(param_2 >> 8), uVar2 != 2)) {
         puVar1[2] = uVar3;
