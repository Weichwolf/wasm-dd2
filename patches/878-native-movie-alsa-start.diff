+/* Native ALSA movie device: start with source PCM, not paused SDL silence.
+ * Wine 10's S16 WaveOut profile uses a 10-ms ALSA period and four periods.
+ * Public ALSA delay reports device-pending frames independently of submission.
+ * Source/driver scheduling and final silence still need whole-output tests. */
+#include <alsa/asoundlib.h>
+#include <dlfcn.h>
+#include <errno.h>
+#define MOVIE_ALSA_SYMBOLS(X) \
+    X(snd_pcm_open) X(snd_pcm_close) X(snd_pcm_drop) X(snd_pcm_prepare) \
+    X(snd_pcm_hw_params_malloc) X(snd_pcm_hw_params_free) X(snd_pcm_hw_params_any) \
+    X(snd_pcm_hw_params_set_access) X(snd_pcm_hw_params_set_format) \
+    X(snd_pcm_hw_params_set_rate_near) X(snd_pcm_hw_params_set_channels) \
+    X(snd_pcm_hw_params_set_period_time_near) X(snd_pcm_hw_params_set_periods_near) \
+    X(snd_pcm_hw_params_set_buffer_size_near) X(snd_pcm_hw_params_get_buffer_size) \
+    X(snd_pcm_hw_params) X(snd_pcm_sw_params_malloc) X(snd_pcm_sw_params_free) \
+    X(snd_pcm_sw_params_current) X(snd_pcm_sw_params_set_start_threshold) \
+    X(snd_pcm_sw_params_set_stop_threshold) X(snd_pcm_sw_params) \
+    X(snd_pcm_avail_update) X(snd_pcm_writei) X(snd_pcm_delay) X(snd_pcm_recover)
+#define MOVIE_ALSA_DECLARE(name) static __typeof__(name)* movie_##name;
+MOVIE_ALSA_SYMBOLS(MOVIE_ALSA_DECLARE)
+#undef MOVIE_ALSA_DECLARE
+static void* movie_alsa_library;
+static struct {
+    snd_pcm_t* device;
+    SDL_mutex* mutex;
+    SDL_Thread* thread;
+    SDL_atomic_t stop;
+    const int16_t* source;
+    int16_t* silence;
+    size_t frames,index;
+    uint64_t written;
+    snd_pcm_uframes_t buffer;
+    int error;
+} movie_alsa;
+static int movie_alsa_symbols(void){
+    if(movie_alsa_library)return 0;
+    movie_alsa_library=dlopen("libasound.so.2",RTLD_NOW|RTLD_GLOBAL);
+    if(!movie_alsa_library)return -1;
+    /* DEFAULT preserves transparent API observers just like normal imports. */
+#define MOVIE_ALSA_LOAD(name) do{movie_##name=dlsym(RTLD_DEFAULT,#name);if(!movie_##name)goto failed;}while(0);
+    MOVIE_ALSA_SYMBOLS(MOVIE_ALSA_LOAD)
+#undef MOVIE_ALSA_LOAD
+    return 0;
+failed:
+    dlclose(movie_alsa_library);movie_alsa_library=NULL;return -1;
+}
+static int movie_alsa_fill(void){
+    snd_pcm_sframes_t available,n;
+    available=movie_snd_pcm_avail_update(movie_alsa.device);
+    if(available==-EPIPE || available==-ESTRPIPE){
+        if(movie_snd_pcm_recover(movie_alsa.device,(int)available,1)<0)return -1;
+        available=movie_snd_pcm_avail_update(movie_alsa.device);
+    }
+    if(available==-EAGAIN)return 0;
+    if(available<0)return -1;
+    if((snd_pcm_uframes_t)available>movie_alsa.buffer)available=movie_alsa.buffer;
+    while(available>0){
+        size_t left=movie_alsa.frames-movie_alsa.index;
+        snd_pcm_uframes_t count=available;
+        const int16_t* data=left?movie_alsa.source+movie_alsa.index*2:movie_alsa.silence;
+        if(left && count>left)count=left;
+        n=movie_snd_pcm_writei(movie_alsa.device,data,count);
+        if(n==-EAGAIN || n==0)return 0;
+        if(n<0)return -1;
+        if(left)movie_alsa.index+=n;
+        movie_alsa.written+=n;available-=n;
+    }
+    return 0;
+}
+static int movie_alsa_worker(void* ignored){
+    (void)ignored;
+    while(!SDL_AtomicGet(&movie_alsa.stop)){
+        SDL_Delay(10);
+        if(SDL_AtomicGet(&movie_alsa.stop))break;
+        SDL_LockMutex(movie_alsa.mutex);
+        if(movie_alsa_fill())movie_alsa.error=1;
+        SDL_UnlockMutex(movie_alsa.mutex);
+        if(movie_alsa.error)break;
+    }
+    return 0;
+}
+static void movie_alsa_stop(void){
+    SDL_AtomicSet(&movie_alsa.stop,1);
+    if(movie_alsa.thread)SDL_WaitThread(movie_alsa.thread,NULL);
+    if(movie_alsa.device){movie_snd_pcm_drop(movie_alsa.device);movie_snd_pcm_close(movie_alsa.device);}
+    if(movie_alsa.mutex)SDL_DestroyMutex(movie_alsa.mutex);
+    free(movie_alsa.silence);memset(&movie_alsa,0,sizeof(movie_alsa));
+}
+static int movie_alsa_start(const int16_t* source,size_t frames,unsigned rate){
+    snd_pcm_hw_params_t* hardware=NULL;snd_pcm_sw_params_t* software=NULL;
+    unsigned obtained=rate,period_us=10000,periods=4;
+    snd_pcm_uframes_t buffer=((rate+50)/100)*4;
+    int period_result;
+    if(movie_alsa_symbols())return -1;
+    if(movie_snd_pcm_open(&movie_alsa.device,"default",SND_PCM_STREAM_PLAYBACK,SND_PCM_NONBLOCK)<0)goto failed;
+    if(movie_snd_pcm_hw_params_malloc(&hardware)<0 || movie_snd_pcm_hw_params_any(movie_alsa.device,hardware)<0 ||
+       movie_snd_pcm_hw_params_set_access(movie_alsa.device,hardware,SND_PCM_ACCESS_RW_INTERLEAVED)<0 ||
+       movie_snd_pcm_hw_params_set_format(movie_alsa.device,hardware,SND_PCM_FORMAT_S16_LE)<0 ||
+       movie_snd_pcm_hw_params_set_rate_near(movie_alsa.device,hardware,&obtained,NULL)<0 || obtained!=rate ||
+       movie_snd_pcm_hw_params_set_channels(movie_alsa.device,hardware,2)<0)goto failed;
+    period_result=movie_snd_pcm_hw_params_set_period_time_near(movie_alsa.device,hardware,&period_us,NULL);
+    if(period_result<0 || period_us<10000){
+        if(movie_snd_pcm_hw_params_set_buffer_size_near(movie_alsa.device,hardware,&buffer)<0)goto failed;
+    }else if(movie_snd_pcm_hw_params_set_periods_near(movie_alsa.device,hardware,&periods,NULL)<0)goto failed;
+    if(movie_snd_pcm_hw_params(movie_alsa.device,hardware)<0 ||
+       movie_snd_pcm_hw_params_get_buffer_size(hardware,&movie_alsa.buffer)<0 ||
+       !movie_alsa.buffer || movie_alsa.buffer>1048576 ||
+       movie_snd_pcm_sw_params_malloc(&software)<0 ||
+       movie_snd_pcm_sw_params_current(movie_alsa.device,software)<0 ||
+       movie_snd_pcm_sw_params_set_start_threshold(movie_alsa.device,software,1)<0 ||
+       movie_snd_pcm_sw_params_set_stop_threshold(movie_alsa.device,software,movie_alsa.buffer)<0 ||
+       movie_snd_pcm_sw_params(movie_alsa.device,software)<0 || movie_snd_pcm_prepare(movie_alsa.device)<0)goto failed;
+    movie_snd_pcm_hw_params_free(hardware);hardware=NULL;
+    movie_snd_pcm_sw_params_free(software);software=NULL;
+    movie_alsa.source=source;movie_alsa.frames=frames;
+    movie_alsa.silence=calloc(movie_alsa.buffer*2,sizeof(int16_t));
+    movie_alsa.mutex=SDL_CreateMutex();
+    if(!movie_alsa.silence || !movie_alsa.mutex || movie_alsa_fill())goto failed;
+    movie_alsa.thread=SDL_CreateThread(movie_alsa_worker,"dd2-movie-alsa",NULL);
+    if(!movie_alsa.thread)goto failed;
+    return 0;
+failed:
+    if(hardware)movie_snd_pcm_hw_params_free(hardware);
+    if(software)movie_snd_pcm_sw_params_free(software);
+    movie_alsa_stop();return -1;
+}
+static int movie_alsa_done(void){
+    snd_pcm_sframes_t pending=0;int result=0;
+    SDL_LockMutex(movie_alsa.mutex);
+    if(movie_alsa.error)result=-1;
+    else if(movie_alsa.index==movie_alsa.frames){
+        int status=movie_snd_pcm_delay(movie_alsa.device,&pending);
+        if(status==-EPIPE)pending=0;
+        else if(status<0)result=-1;
+        if(!result && pending>=0 && (uint64_t)pending<=movie_alsa.written &&
+                movie_alsa.written-(uint64_t)pending>=movie_alsa.frames)result=1;
+    }
+    SDL_UnlockMutex(movie_alsa.mutex);return result;
+}
+#undef MOVIE_ALSA_SYMBOLS
