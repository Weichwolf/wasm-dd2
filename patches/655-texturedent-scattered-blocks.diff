-  undefined1 local_4a;
-  undefined1 local_49;
-  undefined1 local_44 [12];
-  undefined2 local_38;
-  undefined1 local_32;
-  undefined1 local_31;
+  /* contiguous 20-byte dent-uv blocks @ebp-0x58 / @ebp-0x40 (asm 0x43bac1: mov %ax,-0x34(%ebp)
+     = block+0xc, 0x43bacb: mov %al,-0x2e(%ebp) = block+0x12, ...): FUN_0043c700/FUN_0043c868
+     receive the block ADDRESSES and read them as structs (+0xc tpage, +0x12 u, +0x13 v).
+     Ghidra split the blocks into scattered locals; gcc and clang order stack slots
+     differently, so the callees read the WRONG bytes on both targets (and different ones
+     per target): the dent uv delta came out -66 (native) / +116 (wasm) instead of the
+     table value -> car damage texture uv diverged native vs wasm at the first collision. */
+  undefined1 local_5c [20];
+  undefined1 local_44 [20];
+#define local_50 (*(undefined2*)(local_5c+0xc))
+#define local_4a (*(undefined1*)(local_5c+0x12))
+#define local_49 (*(undefined1*)(local_5c+0x13))
+#define local_38 (*(undefined2*)(local_44+0xc))
+#define local_32 (*(undefined1*)(local_44+0x12))
+#define local_31 (*(undefined1*)(local_44+0x13))
   uint local_2c;
   int local_28;
   uint local_24;
@@ -27837,6 +27844,13 @@
 }
 
 
+#undef local_50
