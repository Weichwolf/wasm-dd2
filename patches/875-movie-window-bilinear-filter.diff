Match the actual original AVI window filter under Wine 10/X11.

The existing direct-DIB RGB565 fixture correctly truncates nearest-neighbor
pixels, but the original MCIAVI StretchDIBits window route is different:
Wine 10 winex11.drv/xrender.c xrender_blit selects FilterBilinear and samples
pixel centers with RepeatNone. The observed original source RGB already
matches the portable decoder; its window differs in 25797 bytes at frame zero.
Bilinear sampling before RGB565 conversion explains every byte of that frame.

Keep the direct-DIB helper for its distinct component contract. Production
MCI playback uses the actual window helper on native and WASM. This does not
claim physical display/timing or chronological full movie A/V parity.

Reference implementation:
https://github.com/wine-mirror/wine/blob/wine-10.0/dlls/winex11.drv/xrender.c

--- a/dd2_movie_surface.c
+++ b/dd2_movie_surface.c
@@ -18,3 +18,39 @@
     }
     return 0;
 }
+
+/* Wine 10's X11 window StretchDIBits route selects FilterBilinear before
+ * XRenderComposite, unlike the DIB-section conversion checked above. Sample
+ * centers use the source/destination transform and RepeatNone outside the
+ * source. XRender's 7-bit weights truncate before RGB565 quantization. */
+int dd2_movie_render_window(const uint8_t* rgb,unsigned width,unsigned height,const int32_t* rect,uint32_t* argb) {
+    int x,y;
+    if(!rgb || !width || !height || !rect || !argb || rect[2]<=0 || rect[3]<=0)return -1;
+    for(y=0;y<480;y++)for(x=0;x<640;x++) {
+        int64_t dx=(int64_t)x-rect[0],dy=(int64_t)y-rect[1];
+        uint32_t color=0xff000000u;
+        if(dx>=0 && dy>=0 && dx<rect[2] && dy<rect[3]) {
+            int64_t fx=((2*dx+1)*width*32768)/rect[2]-32768;
+            int64_t fy=((2*dy+1)*height*32768)/rect[3]-32768;
+            int64_t sx=fx>=0 ? fx/65536 : -((-fx+65535)/65536);
+            int64_t sy=fy>=0 ? fy/65536 : -((-fy+65535)/65536);
+            unsigned wx=(unsigned)(fx-sx*65536)>>9;
+            unsigned wy=(unsigned)(fy-sy*65536)>>9;
+            unsigned sums[3]={0,0,0},ix,iy,k,r,g,b;
+            for(iy=0;iy<2;iy++)for(ix=0;ix<2;ix++) {
+                int64_t px=sx+ix,py=sy+iy;
+                unsigned weight=(ix?wx:128-wx)*(iy?wy:128-wy);
+                if(px>=0 && py>=0 && px<width && py<height) {
+                    const uint8_t* p=rgb+((size_t)py*width+(size_t)px)*3;
+                    for(k=0;k<3;k++)sums[k]+=p[k]*weight;
+                }
+            }
+            r=sums[0]>>17;g=sums[1]>>16;b=sums[2]>>17;
+            color|=((r<<3)|(r>>2))<<16;
+            color|=((g<<2)|(g>>4))<<8;
+            color|=(b<<3)|(b>>2);
+        }
+        argb[y*640+x]=color;
+    }
+    return 0;
+}
