-static int64_t movie_alsa_clock_ns(void){
-    struct timespec now;clock_gettime(CLOCK_MONOTONIC,&now);
-    return (int64_t)now.tv_sec*1000000000+now.tv_nsec;
+static int64_t movie_alsa_clock_ticks(void){
+    struct timespec now;
+    /* Wine's ALSA timer correction uses NtQueryPerformanceCounter, separately
+     * from the OS relative sleep and the device's playback sample clock. */
+#ifdef CLOCK_MONOTONIC_RAW
+    if(clock_gettime(CLOCK_MONOTONIC_RAW,&now))
+#endif
+        clock_gettime(CLOCK_MONOTONIC,&now);
+    return (int64_t)now.tv_sec*10000000+now.tv_nsec/100;
 }
