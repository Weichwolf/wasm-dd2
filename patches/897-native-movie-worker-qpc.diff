+    const int64_t period=100000;
+    int64_t delay=period,next=movie_alsa_clock_ticks()+period,adjust;
+    uint32_t low;
     (void)ignored;
     while(!SDL_AtomicGet(&movie_alsa.stop)){
-        struct timespec wait={0,(long)delay},remaining;
+        struct timespec wait={0,(long)(delay*100)},remaining;
         while(nanosleep(&wait,&remaining)<0 && errno==EINTR)wait=remaining;
         if(SDL_AtomicGet(&movie_alsa.stop))break;
         SDL_LockMutex(movie_alsa.mutex);
         if(SDL_AtomicGet(&movie_alsa.stop)){SDL_UnlockMutex(movie_alsa.mutex);break;}
         /* Wine measures wake error before processing this period, advances
          * the target independently, and bounds each correction to half P. */
-        adjust=next-movie_alsa_clock_ns();
+        /* Wine stores the QPC difference in a signed 32-bit int before
+         * clamping it. Express the two's-complement narrowing without UB. */
+        low=(uint32_t)((uint64_t)next-(uint64_t)movie_alsa_clock_ticks());
+        adjust=low<=0x7fffffffu?(int64_t)low:(int64_t)low-4294967296LL;
