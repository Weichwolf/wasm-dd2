+  uVar1 = *(uint *)((int)&DAT_00466eac + param_2 * 4);
+  iVar6 = *(int *)((int)&DAT_00466ebc + param_2 * 4);
   iVar5 = iVar2 + iVar6 * 4;
   if (*(int *)(iVar5 + 0x792aee) < 0xf32) {
