-  *(undefined2 *)(puVar1 + 4) = uStack_e;
-  *puVar1 = local_a;
-  puVar1[1] = local_9;
+  *(undefined2 *)(puVar1 + 2) = *(undefined2 *)(local_1c + 0xc);
+  *(undefined2 *)(puVar1 + 4) = *(undefined2 *)(local_1c + 0xe);
+  *puVar1 = local_1c[0x12];
+  puVar1[1] = local_1c[0x13];
   *(undefined2 *)(puVar1 + 6) = param_3;
   return;
 }
