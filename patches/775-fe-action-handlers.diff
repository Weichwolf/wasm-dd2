FIX FE ACTION HANDLERS (775): reconstruct Go! (0x4507f8) + race-mode cycle (0x4509d8)

Two more unexported front-end handlers from the runtime screen table @0x4697cc
(class of patch 770): the Go!-screen ACTION (call Run_Selection = start the
configured race) and menu screen 0's VALUE-CYCLE handler (Z/S): cycles the
combo index 0x467418 through the 8 (race_mode, race_type) pairs @0x4698f0 --
(Wrecking|Stock Car|Destruction Derby) x (Practice|Championship|Time Trials|
Total Destruction) -- and runs the per-type setup (Select_Pract/Select_DDPract/
Select_TimeT/Select_Total/Select_ChampQS + Championship player-name sprintfs;
asm 0x4509d8-0x450a73 incl. jump table @0x4509c4). Without these the mode
cycle / Go! jumped to raw code VAs. Still unreconstructed (screens 3/4
actions, File Manager 0x44aae0 + CD Player 0x451f70): documented open.

--- a/dd2.c
+++ b/dd2.c
@@ -40787,6 +40787,63 @@
 }
 
 
+/* ===== FUN_004507f8 @ 004507f8 ===== */
+/* Go!-screen ACTION handler (runtime screen table @0x4697cc rec 7 field +4; Ghidra didn't
+   export it -- same class as patch 770): starts the configured race. asm 0x4507f8:
+   call 0x44b978; xor eax,eax; ret. */
+int FUN_004507f8(void)
+{
+  Run_Selection();
+  return 0;
+}
+
+
+/* ===== FUN_004509d8 @ 004509d8 ===== */
+/* Race mode/type VALUE-CYCLE handler of menu screen 0 (runtime screen table rec 0 field +8,
+   invoked by the Z/S "cycle value" path in Front_End). Cycles the combo index 0x467418
+   through the 8 (race_mode, race_type) pairs @0x4698f0 and runs the per-type setup (asm
+   0x4509d8-0x450a73 incl. the 5-way jump table @0x4509c4; Championship additionally
+   sprintf's the two player-name buffers). Reconstructed 1:1; unexported like patch 770's
+   screen thunks -- without it, cycling the race mode jumped to a raw code VA. */
+void __cdecl FUN_004509d8(int param_1)
+{
+  int iVar1;
+  
+  iVar1 = *(int *)GIMG(0x467418);
+  if (param_1 == 0) {
+    iVar1 = iVar1 + -1;
+    if (iVar1 == -1) iVar1 = 7;
+  }
+  else {
+    iVar1 = iVar1 + 1;
+    if (iVar1 == 8) iVar1 = 0;
+  }
+  *(int *)GIMG(0x467418) = iVar1;
+  race_mode = *(int *)GIMG(0x4698f0 + iVar1 * 8);
+  race_type = *(int *)GIMG(0x4698f4 + iVar1 * 8);
+  switch (race_type) {
+  case 0:
+    if (race_mode == 2) { Select_DDPract(); }
+    else { Select_Pract(); }
+    break;
+  case 1:
+    Select_TimeT();
+    break;
+  case 2:
+    Select_Total();
+    break;
+  case 3:
+    break;
+  case 4:
+    Select_ChampQS();
+    FUN_004568ee((char *)GIMG(0x93e318),(char *)GIMG(0x46e740));
+    FUN_004568ee((char *)GIMG(0x93e324),(char *)GIMG(0x46e74c));
+    break;
+  }
+  return;
+}
+
