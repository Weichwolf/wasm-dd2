+#ifndef DD2_BROWSER
+static struct timespec movie_drain_deadline;
+static int movie_drain_armed;
+#endif
+void dd2_movie_drain_start(void) {
+#ifdef DD2_BROWSER
+    movie_drain_start();
+#else
+    /* Wine Sleep(100) is a relative OS wait, separate from movie QPC. */
+    if(clock_gettime(CLOCK_MONOTONIC,&movie_drain_deadline))abort();
+    movie_drain_deadline.tv_nsec+=100000000;
+    if(movie_drain_deadline.tv_nsec>=1000000000){
+        movie_drain_deadline.tv_sec++;movie_drain_deadline.tv_nsec-=1000000000;
+    }
+    movie_drain_armed=1;
+#endif
+}
+int dd2_movie_drain_ready(void) {
+#ifdef DD2_BROWSER
+    return movie_drain_ready();
+#else
+    struct timespec now;
+    if(!movie_drain_armed)return 0;
+    if(clock_gettime(CLOCK_MONOTONIC,&now))abort();
+    return now.tv_sec>movie_drain_deadline.tv_sec ||
+        (now.tv_sec==movie_drain_deadline.tv_sec && now.tv_nsec>=movie_drain_deadline.tv_nsec);
+#endif
+}
+void dd2_movie_drain_cancel(void) {
+#ifdef DD2_BROWSER
+    movie_drain_cancel();
+#else
+    movie_drain_armed=0;
+#endif
+}
 void dd2_movie_wait(void) {
 #ifdef DD2_BROWSER
     emscripten_sleep(1);
