FUN_00428a8c (Car_Camera helper): contiguous stack vectors (scattered-locals class)

The camera-path function keeps three vectors on the stack and passes their bases
to callees: Set_World_Position(&local_54) reads a 4-slot position block
[ebp-0x54..-0x45] (incl. the +0x48 slot copied to 0x77cf1c), and
FUN_004143b0(&local_44, local_64) reads a 3-int source and writes a 3-int result
whose third element Ghidra named local_5c. Split into scalars, gcc scatters them
and the callees hit unrelated stack slots: camera state went garbage, the
strip_vertex index derived from it went wild -> "memory access out of bounds" in
Car_Camera on EVERY wasm level (native's big mmap absorbed the same wild reads
silently). Rebuilt as int _cam_out[3]/_cam_pos[4]/_cam_in[3] with #defines
keeping the decompiled names.

--- a/dd2.c
+++ b/dd2.c
@@ -17211,15 +17211,23 @@
   int *piVar8;
   undefined4 *puVar9;
   int *piVar10;
-  int local_64 [2];
-  int local_5c;
-  int local_54;
-  int local_50;
-  int local_4c;
-  undefined4 uStack_48;
-  int local_44;
-  undefined4 local_40;
-  int local_3c;
+  /* Three contiguous stack vectors (asm frame): GTE-out @[ebp-0x64..-0x59], camera position
+     @[ebp-0x54..-0x45] (Set_World_Position reads it as one block), GTE-in @[ebp-0x44..-0x39]
+     (FUN_004143b0 args). Ghidra split each into scalars; gcc scatters separate locals, so the
+     callees read/wrote unrelated slots -> garbage camera state -> wild strip_vertex indexing
+     (wasm OOB in Car_Camera, absorbed silently by the big native mmap). */
+  int _cam_out[3];
+  int _cam_pos[4];
+  int _cam_in[3];
+#define local_64 (_cam_out)
+#define local_5c (_cam_out[2])
+#define local_54 (_cam_pos[0])
+#define local_50 (_cam_pos[1])
+#define local_4c (_cam_pos[2])
+#define uStack_48 (_cam_pos[3])
+#define local_44 (_cam_in[0])
+#define local_40 (_cam_in[1])
+#define local_3c (_cam_in[2])
   int local_34;
   int local_30;
   int iStack_2c;
@@ -17563,6 +17571,15 @@
   { int _tgt[4]; _tgt[0]=local_34; _tgt[1]=local_30; _tgt[2]=iStack_2c; _tgt[3]=iStack_28; Point_Camera((int *)_tgt,0x800); }
   return;
 }
+#undef local_64
+#undef local_5c
+#undef local_54
+#undef local_50
+#undef local_4c
+#undef uStack_48
+#undef local_44
+#undef local_40
+#undef local_3c
 
 
