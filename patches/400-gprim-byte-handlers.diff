+    *(undefined1 *)((int)_gprim1 + 7) = 0x20;
+    *(undefined1 *)((int)_gprim2 + 7) = 0x20;
     uVar1 = *(undefined4 *)((int)_gpoly + 4);
-    *(undefined4 *)(_gprim2 + 4) = uVar1;
