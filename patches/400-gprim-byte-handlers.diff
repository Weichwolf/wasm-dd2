+    *(undefined1 *)((int)_gprim2 + 4) = 0;
     _gpoly = (int)_gpoly + 0x10;
-    *(undefined1 *)(_gprim1 + 4) = *(undefined1 *)(_gprim2 + 4);
-    _gprim2 = _gprim2 + 0x14;
-    _gprim1 = _gprim1 + 0x14;
+    *(undefined1 *)((int)_gprim1 + 4) = *(undefined1 *)((int)_gprim2 + 4);
+    _gprim2 = (int *)((int)_gprim2 + 0x14);
+    _gprim1 = (int *)((int)_gprim1 + 0x14);
   }
   return;
