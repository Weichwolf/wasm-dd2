FIX SOUND-REGARGS: Play_Sound/Modify_Sound SetVolume/SetFrequency dropped registers

Ghidra dropped the register args of the IDirectSoundBuffer vtable calls in both
functions and substituted stale locals:

Play_Sound @0x415d28:
  - SetVolume (+0x3c) arg is the FUN_004165f4(param_4) volume conversion result
    (asm 0x415e16 mov eax,-0x14; 0x415e30 mov -0x14,ecx; push ecx). The decompile
    passed uVar7=0 (the xor edx,edx @0x415d34 that really inits the loop flag).
  - SetFrequency (+0x44) arg is the pitch-scaled rate (soundrec[+0xc] * param_5),
    signed round-toward-zero /0x1000 (asm 0x415df4 imul; sar 0x1f; shl 0xc; sbb;
    sar 0xc; stored -0x18, pushed @0x415e3a). The decompile passed the buffer
    pointer (piVar6) and dead-code-eliminated the whole computation.

Modify_Sound @0x415f10:
  - SetFrequency (+0x44) arg is (channel basefreq @0x74f124[chan] * param_3) >> 0xc
    UNSIGNED (asm 0x415f63 imul; 0x415f6f shr 0xc; pushed @0x415f96). The decompile
    passed the buffer pointer (piVar3).

Same dropped-register class as patch 645. Only observable with DD2_SOUND=1; the
no-sound path returns before these calls.

--- a/dd2.c
+++ b/dd2.c
@@ -5551,10 +5551,17 @@
       iVar2 = FUN_004165f4(param_4);
       uVar7 = 0;
       piVar6 = piVar1;
+      (void)uVar7; (void)piVar6;
       (**(code **)(*piVar1 + 0x34))(piVar1,0);
       (**(code **)(*piVar1 + 0x40))(piVar1,param_6 * 2);
-      (**(code **)(*piVar1 + 0x3c))(piVar1,uVar7);
-      (**(code **)(*piVar1 + 0x44))(piVar1,piVar6);
+      /* asm 0x415e30: SetVolume gets the FUN_004165f4(param_4) result (Ghidra dropped the
+         register and passed uVar7=0 = the xor edx,edx loop-flag init @0x415d34). */
+      (**(code **)(*piVar1 + 0x3c))(piVar1,iVar2);
+      /* asm 0x415df4-0x415e04 + 0x415e3a: SetFrequency gets the pitch-scaled sample rate
+         (record basefreq @+0xc * param_5) / 0x1000, SIGNED round-toward-zero (sar/shl/sbb).
+         Ghidra dropped the register and passed piVar6 = the buffer pointer. */
+      { int _fm = *(int *)(iVar5 + 0xc) * (int)param_5;
+        (**(code **)(*piVar1 + 0x44))(piVar1,(_fm + ((_fm >> 0x1f) & 0xfff)) >> 0xc); }
       iVar4 = (**(code **)(*piVar1 + 0x30))(piVar1,0,0,iVar4 != 0);
       iVar3 = param_1 * 0x14;
       if (iVar4 == 0) {
@@ -5598,9 +5605,13 @@
     if (piVar1 != (int *)0x0) {
       iVar2 = FUN_004165f4(param_2);
       piVar3 = piVar1;
+      (void)piVar3;
       (**(code **)(*piVar1 + 0x40))(piVar1,param_4 * 2);
       (**(code **)(*piVar1 + 0x3c))(piVar1,iVar2);
-      (**(code **)(*piVar1 + 0x44))(piVar1,piVar3);
+      /* asm 0x415f63-0x415f6f + 0x415f96: SetFrequency gets (channel basefreq @0x74f124
+         * param_3) >> 0xc UNSIGNED (shr). Ghidra dropped the register (piVar3 = buffer ptr). */
+      (**(code **)(*piVar1 + 0x44))
+                (piVar1,(int)((uint)(*(int *)(&DAT_0074f124 + param_1 * 0x14) * (int)param_3) >> 0xc));
       *(short *)(&DAT_0074f132 + param_1 * 0x14) = (short)iVar2;
     }
