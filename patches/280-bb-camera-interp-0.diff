-                local_20;
+                _DZ(local_20);
         iVar3 = *(int *)(&DAT_0078a744 + iVar4) * 0x100 +
                 (_camera_fd - *(int *)(&DAT_0078a744 + iVar4)) * iVar2;
         iVar5 = iVar3 >> 0x1f;
