FIX DSLOAD-DESC-LOCALS: DSLoadSoundBuffer DSBUFFERDESC is one contiguous stack block

Scattered-locals artifact, twin of patch 705: DSLoadSoundBuffer @0x4156a8 fills a
contiguous 0x14-byte DSBUFFERDESC on its frame with a 5-dword template copy from
DAT_00415694 (dwSize/dwFlags/dwBufferBytes/dwReserved/lpwfxFormat), then passes
&block to IDirectSound::CreateSoundBuffer, which reads dwFlags @+4, dwBufferBytes
@+8 and lpwfxFormat @+0x10 relative to that pointer. Ghidra split the block into
scalar locals local_2c/local_28/local_24/uStack_20/local_1c; gcc reorders scalars,
so the shim read garbage (lpwfxFormat=0xe6 -> SIGSEGV). FUN_004158e4 also writes
the parsed wfx/size into local_1c/local_24 = block fields +0x10/+8 (asm-consistent).
Only reachable with DD2_SOUND=1.

--- a/dd2.c
+++ b/dd2.c
@@ -5093,11 +5093,17 @@
 {
   int *piVar1;
   int iVar2;
-  undefined4 local_2c;
-  undefined4 local_28;
-  uint local_24;
-  undefined4 uStack_20;
-  int local_1c;
+  /* ONE contiguous 0x14-byte DSBUFFERDESC block (asm 0x4156b5: the 5-dword template copy from
+     DAT_00415694 fills a contiguous stack struct; CreateSoundBuffer then reads dwFlags @+4,
+     dwBufferBytes @+8, lpwfxFormat @+0x10 relative to &local_2c). Ghidra split it into scalar
+     locals which gcc reorders -> the shim's desc[1]/[2]/[4] reads hit unrelated slots (wfx
+     garbage 0xe6 -> crash). Same scattered-locals class as patch 705/070/655. */
+  undefined4 _dsbdesc2[5];
+#define local_2c (_dsbdesc2[0])
+#define local_28 (_dsbdesc2[1])
+#define local_24 (*(uint*)&_dsbdesc2[2])
+#define uStack_20 (_dsbdesc2[3])
+#define local_1c (*(int*)&_dsbdesc2[4])
   int *local_18;
   undefined4 *local_14;
   
@@ -5137,6 +5143,11 @@
   }
   return local_18;
 }
+#undef local_2c
+#undef local_28
+#undef local_24
+#undef uStack_20
+#undef local_1c
 
 
 /* ===== FUN_0041579c @ 0041579c ===== */
