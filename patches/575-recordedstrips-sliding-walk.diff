Init_Track_Objects: recorded_strips chain walk uses a SLIDING base (dropped edx increment)

asm 0x430e28-0x430e3d: the fill loop advances BOTH the store index (eax) and the
strip-data base register (edx, add edx,4 per iteration); the chain step reads
*(strip_data + 4*i + strip + 0x1c). Ghidra dropped the loop-carried edx and
emitted a fixed +0x1c read, and rendered the post-loop cursor as strip_data+4
instead of strip_data+0x300 (asm 0x430e3f: add edx,ebx). Both faithfully
replicated. Reference stream capture (L2, per-frame trackstate) shows our
recorded_strips_ diverging from the original from entry [2] onward exactly as
this off-by-slide predicts.

--- a/dd2.c
+++ b/dd2.c
@@ -21650,10 +21650,13 @@
   do {
     iVar1 = _strip_data;
     *(int *)(&recorded_strips_ + iVar3) = iVar4;
+    /* asm 0x430e31/0x430e35: mov ebx,[edx+ebx+0x1c]; add edx,4 -- the strip-chain step uses a
+       SLIDING base (strip_data + 4*i), i.e. link offset 0x1c+4*i per iteration; Ghidra folded the
+       loop-carried edx away and read a fixed +0x1c. Code is the truth: replicate the slide. */
+    iVar4 = *(int *)(iVar1 + iVar3 + 0x1c + iVar4);
     iVar3 = iVar3 + 4;
-    iVar4 = *(int *)(iVar1 + 0x1c + iVar4);
   } while (iVar3 != 0x300);
-  iStack_14 = iVar1 + 4 + iVar4;
+  iStack_14 = iVar1 + 0x300 + iVar4;  /* asm 0x430e3f: add edx,ebx with edx = strip_data+0x300 */
