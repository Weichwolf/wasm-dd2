 #define _DAT_00469674 (*(short*)GIMG(0x00469674))
 #define _DAT_00469676 (*(short*)GIMG(0x00469676))
-#define _DAT_0046968c (*(int*)GIMG(0x0046968c))
-#define _DAT_0046968e (*(int*)GIMG(0x0046968e))
