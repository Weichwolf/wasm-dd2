The Watcom character classification table is a BYTE array. FUN_004222b4
tests decimal digits with MOV DH,BYTE PTR [ECX+0x46fdb0] and TEST DH,0x20
at 0x4222e4/0x4222eb. The old int lvalue multiplied every character index
by four: numeric Print commands returned zero and consumed the wrong text
extent. Retype the table to match its literal original byte lookup; this
also preserves the byte classification used by the other CRT callers.

The original atoi at 0x456970/0x456977/0x45697a accumulates decimal digits
with wrapping 32-bit IMUL/ADD/SUB; 0x456988 negates the same DWORD.
glibc's 32-bit atoi saturates overflowing longs instead. Reconstruct the
literal wrapping conversion of this already bounded decimal buffer; do not
delegate its overflow behavior to a platform libc.

--- a/dd2_symbols.h
+++ b/dd2_symbols.h
@@ -1082,1 +1082,1 @@
-#define _IsTable (*(int*)GIMG(0x0046fdb0))
+#define _IsTable (*(byte*)GIMG(0x0046fdb0))
--- a/dd2.c
+++ b/dd2.c
@@ -13343,5 +13343,6 @@
   char *pcVar1;
   int iVar2;
+  uint magnitude;
   char local_18 [12];
   
   iVar2 = 0;
@@ -13360,3 +13361,9 @@
-  iVar2 = atoi(local_18);
-  *param_1 = iVar2;
+  /* Watcom atoi's DWORD arithmetic wraps rather than saturating. */
+  magnitude = 0;
+  pcVar1 = local_18;
+  if (*pcVar1 == '-') pcVar1++;
+  for (; *pcVar1 >= '0' && *pcVar1 <= '9'; pcVar1++) {
+    magnitude = magnitude * 10U + (uint)(*pcVar1 - '0');
+  }
+  *param_1 = (int)(local_18[0] == '-' ? 0U - magnitude : magnitude);
   return param_3;
